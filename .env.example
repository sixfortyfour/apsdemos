APS_CLIENT_ID=
APS_CLIENT_SECRET=
LOGIN_PASSPHRASE=

# Optional - defaults to `${APS_CLIENT_ID}-basic-app` if unset
APS_BUCKET=

# Optional - defaults to 8080
PORT=

# Optional - a random secret is generated per process start if unset
# (sessions won't survive a server restart in that case)
SESSION_SECRET=

# Optional, and only used together - if both are set, the server registers a Model Derivative
# webhook on startup so translation completion is detected immediately instead of only via
# polling. Requires a public HTTPS URL, so this only makes sense for a deployed instance.
# APS_WEBHOOK_CALLBACK_BASE_URL is this app's own public base URL, e.g.
# https://your-app.azurewebsites.net (no trailing slash).
APS_WEBHOOK_CALLBACK_BASE_URL=

# A secret you choose, used to sign/verify webhook callbacks. Keep it out of source control.
APS_WEBHOOK_SECRET=
